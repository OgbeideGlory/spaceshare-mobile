# Copy this file to .env.local to change settings on your computer.
# Anything starting with EXPO_PUBLIC_ is built INTO the app, so anyone can read it.
# Never put passwords or secret keys here.

# The backend API. Leave empty to use the live server (https://space-share-p3on.onrender.com).
EXPO_PUBLIC_API_URL=

# Google sign-in (client IDs are public by design, so they're fine here).
# The web one is the same as the website's. The phone ones are created in the same Google Cloud
# project (see PendingUpdates.md). The button stays hidden until these are set AND the app runs
# as a development build (Expo Go can't do Google sign-in).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=223033024568-ugeea5e2s5p1vhfvh0pdjmq8tinjsm56.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android has no ID in the app: Google matches the app's package name + SHA-1 instead. Set to true once that's registered.
EXPO_PUBLIC_GOOGLE_ANDROID_READY=false
